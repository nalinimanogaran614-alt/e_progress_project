# Application
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
PORT=5000

# Local Docker MySQL defaults
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=e_progress_card
DB_USER=eprogress
DB_PASSWORD=eprogress_local
DB_ROOT_PASSWORD=root_dev_password

# Railway MySQL public connection (recommended for Vercel)
# You may set MYSQL_PUBLIC_URL alone, or use the five variables below.
# MYSQL_PUBLIC_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE

# Alternatively:
# DB_HOST=...
# DB_PORT=...
# DB_NAME=e_progress_card
# DB_USER=...
# DB_PASSWORD=...
